{
  "name": "todoenuno",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "downloader": "node server/downloader.js",
    "predev": "node scripts/ffmpeg-core.mjs && node scripts/libarchive.mjs",
    "prebuild": "node scripts/ffmpeg-core.mjs && node scripts/libarchive.mjs",
    "desktop": "npm run build && electron .",
    "desktop:binaries": "node scripts/desktop-binaries.mjs",
    "desktop:win": "npm run build && npm run desktop:binaries && electron-builder --win --x64"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@neslinesli93/qpdf-wasm": "^0.3.1",
    "docx-preview": "^0.4.1",
    "heic2any": "^0.0.4",
    "jsqr": "^1.4.0",
    "jszip": "^3.10.2",
    "libarchive.js": "^2.0.2",
    "lucide": "^1.71.0",
    "marked": "^18.2.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "pptx-preview": "^1.0.7",
    "qrcode": "^1.5.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@ffmpeg/core": "^0.12.10",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "vite": "^8.3.7"
  },
  "main": "electron/main.js",
  "description": "Herramientas de imagen, PDF, documentos, video, audio y texto en una sola app.",
  "author": "Javier Stiven Martínez Cáceres",
  "build": {
    "appId": "app.netlify.todoenunoapp",
    "productName": "TodoEnUno",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "server/**",
      "package.json",
      "!node_modules/**",
      "!dist/_headers",
      "!dist/sw.js"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "msi",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon-512.png",
      "extraResources": [
        {
          "from": "desktop/bin/win",
          "to": "bin"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TodoEnUno",
      "artifactName": "TodoEnUno-Instalador.${ext}"
    },
    "msi": {
      "oneClick": false,
      "perMachine": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TodoEnUno",
      "artifactName": "TodoEnUno-Instalador.${ext}"
    },
    "portable": {
      "artifactName": "TodoEnUno-Portable.${ext}"
    },
    "linux": {
      "target": [
        "dir"
      ],
      "icon": "public/icon-512.png"
    }
  }
}
